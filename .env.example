# Next.js (.env.local)

# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google AI Studio key for the AI assistant (read by @ai-sdk/google).
# Without it, /api/ai-chat fails; the rest of the app works.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Canonical URL for metadata, sitemap and blog. Defaults to https://dbluna.com
NEXT_PUBLIC_SITE_URL=

# Convex dashboard → Settings → Environment variables (not .env.local)
#
# CLERK_JWT_ISSUER_DOMAIN=              Clerk "convex" JWT template issuer, e.g. https://xxx.clerk.accounts.dev
# CLERK_WEBHOOK_SECRET=                 Signing secret of the webhook pointed at <CONVEX_SITE_URL>/clerk
# AI_CHAT_GLOBAL_MONTHLY_CREDIT_CEILING= Optional. Org-wide monthly AI credit cap; defaults to 100000
